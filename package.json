{
  "name": "craft-remote",
  "displayName": "Craft Remote",
  "description": "Open SFTP and FTP/FTPS folders directly in the Explorer, no local copy.",
  "version": "0.2.1",
  "publisher": "staatzstreich",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onFileSystem:craftremote",
    "onView:craftRemote.profiles",
    "onCommand:craftRemote.connect"
  ],
  "contributes": {
    "commands": [
      {
        "command": "craftRemote.connect",
        "title": "Verbinden",
        "category": "Craft Remote",
        "icon": "$(plug)"
      },
      {
        "command": "craftRemote.addProfile",
        "title": "Profil anlegen …",
        "category": "Craft Remote",
        "icon": "$(add)"
      },
      {
        "command": "craftRemote.editProfiles",
        "title": "Profile bearbeiten (settings.json)",
        "category": "Craft Remote",
        "icon": "$(gear)"
      },
      {
        "command": "craftRemote.forgetPassword",
        "title": "Gespeichertes Passwort vergessen …",
        "category": "Craft Remote"
      },
      {
        "command": "craftRemote.reconnect",
        "title": "Verbindung neu aufbauen",
        "category": "Craft Remote"
      },
      {
        "command": "craftRemote.forgetHostKeys",
        "title": "Bekannte Server vergessen",
        "category": "Craft Remote"
      },
      {
        "command": "craftRemote.showLog",
        "title": "Zeitmessung anzeigen",
        "category": "Craft Remote",
        "icon": "$(output)"
      },
      {
        "command": "craftRemote.disconnect",
        "title": "Trennen",
        "category": "Craft Remote",
        "icon": "$(debug-disconnect)"
      }
    ],
    "configuration": {
      "title": "Craft Remote",
      "properties": {
        "craftRemote.profiles": {
          "type": "array",
          "default": [],
          "description": "Gespeicherte Verbindungen. Passwörter liegen nicht hier, sondern im Schlüsselbund.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "protocol",
              "host"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Anzeigename; wird im Explorer als Ordnername benutzt."
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "sftp",
                  "ftp",
                  "ftps"
                ]
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "number",
                "description": "Standard: 22 (sftp), 21 (ftp/ftps)"
              },
              "username": {
                "type": "string",
                "description": "Bei FTP leer = anonym"
              },
              "privateKeyPath": {
                "type": "string",
                "description": "Nur SFTP, z. B. ~/.ssh/id_ed25519"
              },
              "remotePath": {
                "type": "string",
                "description": "Startordner; leer = Home bzw. Login-Verzeichnis"
              }
            }
          }
        },
        "craftRemote.openIn": {
          "type": "string",
          "enum": [
            "window",
            "addToWindow"
          ],
          "enumDescriptions": [
            "Im eigenen Fenster: ein leeres Fenster wird benutzt, sonst öffnet sich ein neues. Kein „Untitled Workspace“.",
            "Als zusätzlicher Ordner im aktuellen Fenster (macht daraus einen Multi-Root-Workspace)."
          ],
          "default": "window",
          "description": "Wo ein Remote-Ordner beim Verbinden geöffnet wird."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "craftRemote",
          "title": "Craft Remote",
          "icon": "resources/remote.svg"
        }
      ]
    },
    "views": {
      "craftRemote": [
        {
          "id": "craftRemote.profiles",
          "name": "Verbindungen"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "craftRemote.profiles",
        "contents": "Noch kein Profil angelegt.\n[Profil anlegen](command:craftRemote.addProfile)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "craftRemote.addProfile",
          "when": "view == craftRemote.profiles",
          "group": "navigation@1"
        },
        {
          "command": "craftRemote.editProfiles",
          "when": "view == craftRemote.profiles",
          "group": "navigation@2"
        },
        {
          "command": "craftRemote.showLog",
          "when": "view == craftRemote.profiles",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "craftRemote.connect",
          "when": "view == craftRemote.profiles && viewItem == profile.disconnected",
          "group": "inline"
        },
        {
          "command": "craftRemote.disconnect",
          "when": "view == craftRemote.profiles && viewItem == profile.connected",
          "group": "inline"
        },
        {
          "command": "craftRemote.forgetPassword",
          "when": "view == craftRemote.profiles",
          "group": "9_password"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --external:cpu-features --external:./crypto/build/Release/sshcrypto.node --outfile=out/extension.js --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "basic-ftp": "^6.2.3",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@types/bunyan": "^1.8.11",
    "@types/node": "^26.6.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/vscode": "1.90",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ftp-srv": "^4.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}