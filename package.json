{
  "name": "ftp-buddy",
  "displayName": "FTP Buddy",
  "description": "SFTP, FTP und FTPS in der Seitenleiste: durchsuchen, bearbeiten, hoch- und herunterladen, ohne lokale Kopie.",
  "version": "0.11.1",
  "publisher": "staatzstreich",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onFileSystem:ftpbuddy",
    "onView:ftpBuddy.profiles",
    "onCommand:ftpBuddy.connect"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ftpBuddy.connect",
        "title": "Verbinden",
        "category": "FTP Buddy",
        "icon": "$(plug)"
      },
      {
        "command": "ftpBuddy.addProfile",
        "title": "Profil anlegen …",
        "category": "FTP Buddy",
        "icon": "$(add)"
      },
      {
        "command": "ftpBuddy.editProfiles",
        "title": "Profile bearbeiten (settings.json)",
        "category": "FTP Buddy",
        "icon": "$(gear)"
      },
      {
        "command": "ftpBuddy.forgetPassword",
        "title": "Gespeichertes Passwort vergessen …",
        "category": "FTP Buddy"
      },
      {
        "command": "ftpBuddy.reconnect",
        "title": "Verbindung neu aufbauen",
        "category": "FTP Buddy"
      },
      {
        "command": "ftpBuddy.forgetHostKeys",
        "title": "Bekannte Server vergessen",
        "category": "FTP Buddy"
      },
      {
        "command": "ftpBuddy.showLog",
        "title": "Zeitmessung anzeigen",
        "category": "FTP Buddy",
        "icon": "$(output)"
      },
      {
        "command": "ftpBuddy.disconnect",
        "title": "Trennen",
        "category": "FTP Buddy",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "ftpBuddy.newFile",
        "title": "Neue Datei …",
        "category": "FTP Buddy",
        "icon": "$(new-file)"
      },
      {
        "command": "ftpBuddy.newFolder",
        "title": "Neuer Ordner …",
        "category": "FTP Buddy",
        "icon": "$(new-folder)"
      },
      {
        "command": "ftpBuddy.rename",
        "title": "Umbenennen …",
        "category": "FTP Buddy"
      },
      {
        "command": "ftpBuddy.delete",
        "title": "Löschen …",
        "category": "FTP Buddy"
      },
      {
        "command": "ftpBuddy.copyPath",
        "title": "Pfad kopieren",
        "category": "FTP Buddy"
      },
      {
        "command": "ftpBuddy.refresh",
        "title": "Aktualisieren",
        "category": "FTP Buddy",
        "icon": "$(refresh)"
      },
      {
        "command": "ftpBuddy.upload",
        "title": "Hochladen …",
        "category": "FTP Buddy",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ftpBuddy.download",
        "title": "Herunterladen",
        "category": "FTP Buddy",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ftpBuddy.uploadFromExplorer",
        "title": "Zu FTP Buddy hochladen",
        "category": "FTP Buddy"
      },
      {
        "command": "ftpBuddy.goRoot",
        "title": "Wurzelverzeichnis / anzeigen",
        "category": "FTP Buddy",
        "icon": "$(root-folder)"
      },
      {
        "command": "ftpBuddy.goUp",
        "title": "Eine Ebene höher",
        "category": "FTP Buddy",
        "icon": "$(arrow-up)"
      },
      {
        "command": "ftpBuddy.goStart",
        "title": "Zum Startordner",
        "category": "FTP Buddy",
        "icon": "$(home)"
      },
      {
        "command": "ftpBuddy.setRoot",
        "title": "Hier als oberste Ebene anzeigen",
        "category": "FTP Buddy"
      }
    ],
    "configuration": {
      "title": "FTP Buddy",
      "properties": {
        "ftpBuddy.profiles": {
          "type": "array",
          "default": [],
          "description": "Gespeicherte Verbindungen. Passwörter liegen nicht hier, sondern im Schlüsselbund.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "protocol",
              "host"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Anzeigename; wird im Explorer als Ordnername benutzt."
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "sftp",
                  "ftp",
                  "ftps",
                  "ftps-implicit"
                ]
              },
              "host": {
                "type": "string",
                "description": "Bei SFTP auch ein Alias aus ~/.ssh/config (HostName, Port, User, IdentityFile)"
              },
              "port": {
                "type": "number",
                "description": "Standard: 22 (sftp), 21 (ftp/ftps), 990 (ftps-implicit)"
              },
              "username": {
                "type": "string",
                "description": "Bei FTP leer = anonym"
              },
              "privateKeyPath": {
                "type": "string",
                "description": "Nur SFTP, z. B. ~/.ssh/id_ed25519; leer = IdentityFile aus ~/.ssh/config"
              },
              "useAgent": {
                "type": "boolean",
                "description": "Nur SFTP: Schlüssel des laufenden ssh-agent verwenden (SSH_AUTH_SOCK)"
              },
              "remotePath": {
                "type": "string",
                "description": "Startordner; leer = Home bzw. Login-Verzeichnis"
              },
              "localPath": {
                "type": "string",
                "description": "Lokaler Ordner, der dem Startordner (remotePath, sonst Home) entspricht. Hoch- und Herunterladen behalten dann die Ordnerstruktur."
              }
            }
          }
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ftpBuddy",
          "title": "FTP Buddy",
          "icon": "resources/remote.svg"
        }
      ]
    },
    "views": {
      "ftpBuddy": [
        {
          "id": "ftpBuddy.profiles",
          "name": "Verbindungen"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ftpBuddy.profiles",
        "contents": "Noch kein Profil angelegt.\n[Profil anlegen](command:ftpBuddy.addProfile)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ftpBuddy.refresh",
          "when": "view == ftpBuddy.profiles",
          "group": "navigation@0"
        },
        {
          "command": "ftpBuddy.addProfile",
          "when": "view == ftpBuddy.profiles",
          "group": "navigation@1"
        },
        {
          "command": "ftpBuddy.editProfiles",
          "when": "view == ftpBuddy.profiles",
          "group": "navigation@2"
        },
        {
          "command": "ftpBuddy.showLog",
          "when": "view == ftpBuddy.profiles",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "ftpBuddy.connect",
          "when": "view == ftpBuddy.profiles && viewItem == profile.disconnected",
          "group": "inline"
        },
        {
          "command": "ftpBuddy.disconnect",
          "when": "view == ftpBuddy.profiles && viewItem == profile.connected",
          "group": "inline"
        },
        {
          "command": "ftpBuddy.forgetPassword",
          "when": "view == ftpBuddy.profiles",
          "group": "9_password"
        },
        {
          "command": "ftpBuddy.newFile",
          "when": "view == ftpBuddy.profiles && viewItem == remote.dir",
          "group": "inline@1"
        },
        {
          "command": "ftpBuddy.newFolder",
          "when": "view == ftpBuddy.profiles && viewItem == remote.dir",
          "group": "inline@2"
        },
        {
          "command": "ftpBuddy.newFile",
          "when": "view == ftpBuddy.profiles && viewItem == remote.dir",
          "group": "1_new@1"
        },
        {
          "command": "ftpBuddy.newFolder",
          "when": "view == ftpBuddy.profiles && viewItem == remote.dir",
          "group": "1_new@2"
        },
        {
          "command": "ftpBuddy.newFile",
          "when": "view == ftpBuddy.profiles && viewItem == remote.file",
          "group": "1_new@1"
        },
        {
          "command": "ftpBuddy.newFolder",
          "when": "view == ftpBuddy.profiles && viewItem == remote.file",
          "group": "1_new@2"
        },
        {
          "command": "ftpBuddy.rename",
          "when": "view == ftpBuddy.profiles && viewItem =~ /^remote\\./",
          "group": "2_edit@1"
        },
        {
          "command": "ftpBuddy.delete",
          "when": "view == ftpBuddy.profiles && viewItem =~ /^remote\\./",
          "group": "2_edit@2"
        },
        {
          "command": "ftpBuddy.copyPath",
          "when": "view == ftpBuddy.profiles && viewItem =~ /^remote\\./",
          "group": "3_path"
        },
        {
          "command": "ftpBuddy.upload",
          "when": "view == ftpBuddy.profiles && viewItem == remote.dir",
          "group": "inline@0"
        },
        {
          "command": "ftpBuddy.upload",
          "when": "view == ftpBuddy.profiles && viewItem == profile.connected",
          "group": "inline@0"
        },
        {
          "command": "ftpBuddy.upload",
          "when": "view == ftpBuddy.profiles && viewItem =~ /^remote\\./ || view == ftpBuddy.profiles && viewItem == profile.connected",
          "group": "0_transfer@1"
        },
        {
          "command": "ftpBuddy.download",
          "when": "view == ftpBuddy.profiles && viewItem =~ /^remote\\./",
          "group": "0_transfer@2"
        },
        {
          "command": "ftpBuddy.goUp",
          "when": "view == ftpBuddy.profiles && viewItem == profile.connected",
          "group": "inline@1"
        },
        {
          "command": "ftpBuddy.goRoot",
          "when": "view == ftpBuddy.profiles && viewItem == profile.connected",
          "group": "4_view@1"
        },
        {
          "command": "ftpBuddy.goStart",
          "when": "view == ftpBuddy.profiles && viewItem == profile.connected",
          "group": "4_view@2"
        },
        {
          "command": "ftpBuddy.setRoot",
          "when": "view == ftpBuddy.profiles && viewItem == remote.dir",
          "group": "4_view@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ftpBuddy.newFile",
          "when": "false"
        },
        {
          "command": "ftpBuddy.newFolder",
          "when": "false"
        },
        {
          "command": "ftpBuddy.rename",
          "when": "false"
        },
        {
          "command": "ftpBuddy.delete",
          "when": "false"
        },
        {
          "command": "ftpBuddy.copyPath",
          "when": "false"
        },
        {
          "command": "ftpBuddy.upload",
          "when": "false"
        },
        {
          "command": "ftpBuddy.download",
          "when": "false"
        },
        {
          "command": "ftpBuddy.uploadFromExplorer",
          "when": "false"
        },
        {
          "command": "ftpBuddy.goRoot",
          "when": "false"
        },
        {
          "command": "ftpBuddy.goUp",
          "when": "false"
        },
        {
          "command": "ftpBuddy.goStart",
          "when": "false"
        },
        {
          "command": "ftpBuddy.setRoot",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "ftpBuddy.uploadFromExplorer",
          "when": "resourceScheme == file",
          "group": "7_modification@9"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --external:cpu-features --external:./crypto/build/Release/sshcrypto.node --outfile=out/extension.js --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "basic-ftp": "^6.2.3",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@types/bunyan": "^1.8.11",
    "@types/node": "^26.6.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/vscode": "1.90",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ftp-srv": "^4.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
